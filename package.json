{
  "name": "livescope",
  "version": "0.1.0",
  "private": true,
  "description": "치지직 라이브 방송인 탐색기 · CHZZK-STREAM-EXPLORER (AI)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node scripts/test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "channels": "tsx scripts/channels.ts",
    "sync": "tsx scripts/sync.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "postgres": "^3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.2.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.0"
  }
}
